APP_NAME=SmashZone
APP_ENV=development
# Không bắt buộc. App tự nhận diện đường dẫn từ request.
# Chỉ cần đặt khi chạy ngoài web entry point (CLI/script).
# APP_URL=http://localhost/BadmintonBooking/public

# Tự tạo database + import schema ở lần chạy đầu. Đặt false để tắt.
AUTO_INSTALL=true

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=badminton_booking
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_LIFETIME=120
